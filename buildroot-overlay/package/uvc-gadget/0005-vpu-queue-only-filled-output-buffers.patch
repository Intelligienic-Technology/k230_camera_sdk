-	printf("vpu_thread start, TID: %d\n", (int)syscall(SYS_gettid));
+	struct timespec deadline;
+	int ret = 0;
 
-	/* Frame interval in microseconds (30fps = ~33333us) */
-	//uint64_t frame_interval_us = (src->frame_rate > 0) ? (1000000 / src->frame_rate) : 33333;
+	if (clock_gettime(CLOCK_REALTIME, &deadline) < 0)
+		return -errno;
+	deadline.tv_nsec += 5000000;
+	if (deadline.tv_nsec >= 1000000000) {
+		deadline.tv_sec++;
+		deadline.tv_nsec -= 1000000000;
+	}
+	pthread_mutex_lock(&src->packet_mutex);
+	if (!atomic_load(&src->stop_flag))
+		ret = pthread_cond_timedwait(&src->packet_cond, &src->packet_mutex, &deadline);
+	if (atomic_load(&src->stop_flag))
+		ret = ECANCELED;
+	pthread_mutex_unlock(&src->packet_mutex);
+	return ret && ret != ETIMEDOUT ? -ret : 0;
+}
 
