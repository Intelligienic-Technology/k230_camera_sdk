+/* FFmpeg does not expose its v4l2 fd for poll(). Wait briefly on the
+ * stop condition after nonblocking EAGAIN, rather than spinning or blocking
+ * inside DQBUF. STREAMOFF broadcasts this condition to wake us immediately. */
+static int vpu_source_wait_for_frame(struct vpu_source *src)
 {
-	struct vpu_source *src = (struct vpu_source *)arg;
-	int ret;
