+static void uvc_stream_vpu_disarm_timer(struct uvc_stream *stream)
+{
+	struct itimerspec timeout = { 0 };
+	uint64_t expirations;
+	ssize_t ret;
+
+	if (stream->startup_fd < 0)
+		return;
+	timerfd_settime(stream->startup_fd, 0, &timeout, NULL);
+	do {
+		ret = read(stream->startup_fd, &expirations, sizeof(expirations));
+	} while (ret == sizeof(expirations) || (ret < 0 && errno == EINTR));
+}
+
+static void uvc_stream_vpu_timeout(void *d)
+{
+	struct uvc_stream *stream = d;
+	uint64_t expirations;
+	ssize_t ret;
+
+	do {
+		ret = read(stream->startup_fd, &expirations, sizeof(expirations));
+	} while (ret < 0 && errno == EINTR);
+	if (ret == sizeof(expirations) && stream->vpu_active && !stream->sink_started)
+		uvc_stream_vpu_fail(stream, "startup timeout (10 seconds)", -ETIMEDOUT);
